.gradle/
/build/
/app/build/
*.iml
.idea/
local.properties

# Local Claude Code / agent tooling — never part of the project.
# .agents/AGENTS.md points at the maintainer's private OneDrive knowledge
# base; .claude/settings.local.json holds machine-specific permission
# grants. Both would leak paths and bake-in environment differences if
# committed.
.agents/
.claude/

# Local CodeGraph index (SQLite DB + watcher daemon artifacts). Generated by
# `codegraph start` on the developer's machine; the 5 MB+ database would churn
# every time the indexer runs.
.codegraph/

# Transient review/portable patch artifacts. Used to share a working-tree
# delta as a unified diff before it's been committed; once the change is
# committed the file is obsolete.
docs/patches/
