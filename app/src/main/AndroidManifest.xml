<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      INTERNET: required for SSHJ to open a TCP socket to the SSH server.
                Without this, the kernel rejects every socket() call with EPERM
                and connect() never reaches the wire.
      ACCESS_NETWORK_STATE: lets the SshClient probe WiFi/cell before opening
                a socket, so we can surface "no network" as a friendly error
                instead of a generic EPERM.
      These are normal-protection permissions; Android grants them at install
      time without prompting the user.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      FOREGROUND_SERVICE: required API 28+ for any process that calls
        Service.startForeground(). Promotes the app into the "perceptible"
        priority bucket so the OS does not kill us when the user backgrounds
        the app mid-session.
      FOREGROUND_SERVICE_DATA_SYNC: required API 34+ specifically for
        ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC. Mismatch between the
        manifest-declared type and the runtime-passed type crashes the
        process on API 34.
      POST_NOTIFICATIONS: required API 33+ for the system to actually show
        the foreground-service notification. Without it, startForeground
        still succeeds (the service runs), but the user sees nothing in the
        shade — defeating the purpose of the persistent notification.
        Requested at runtime on first connect (see SshTermApp.kt).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
      FOREGROUND_SERVICE_SPECIAL_USE: API 34+ type for long-lived interactive
      SSH sessions. dataSync is quota-limited and OEM-deferred (BG-KA-05:
      Handler.postDelayed gaps of ~15 s despite WakeLock). specialUse is the
      documented escape hatch; subtype property is required on the <service>.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- PARTIAL_WAKE_LOCK: keeps the CPU available for sshj's reader thread
         to respond to server-side ClientAlive probes while the app is
         backgrounded. TCP keepalive alone is not enough — sshd counts SSH
         protocol activity, not kernel TCP probes (BG-KA-03). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      REQUEST_IGNORE_BATTERY_OPTIMIZATIONS: OEM Doze / "battery savers" freeze
      even FGS + PARTIAL_WAKE_LOCK threads (BG-KA-06 device log: Thread.sleep
      deferred ~40 s after nudge #4, Tailscale RST). The Connected-state
      prompt asks the user once; without the exemption background SSH dies.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <application
        android:name=".SshTermApplication"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:label="SSH Term">
        <!--
          configChanges: we deliberately swallow every config change so
          the Activity is NOT destroyed/recreated. Two reasons:

          1. Split-screen (the primary use case on a tablet) flips
             screenSize + screenLayout. Without this list, Android
             recreates MainActivity mid-session, the SSH client reference
             in SshTermApp's `remember` is lost, and the user is dumped
             back on the login page — even though the SSH session itself
             is still alive on the keepalive-promoted process.
          2. The terminal pane's PTY geometry is a function of the View
             size, and TerminalView's layout listener already forwards
             size changes to the remote as SIGWINCH. So a config change
             "just works" — the emulator remeasures, the IO loop keeps
             reading, the user sees the same session in a new size.

          Process death is the *other* path that loses state; that's
          covered separately by ActiveSshSessionStore + rememberSaveable
          in SshTermApp. The keepalive service puts the process in the
          "perceptible" priority bucket, so config changes are by far
          the common case.

          resizeableActivity="true" is the API 24+ default but stated
          explicitly here so a future minSdk bump to pre-N doesn't
          silently disable split-screen support.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale|locale"
            android:exported="true"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
          Started (not bound) foreground service. Started from SshClient on
          successful connect and stopped from SshClient.disconnect().
          specialUse|dataSync: API 34+ uses specialUse at runtime; older
          APIs fall back to dataSync. The PROPERTY_SPECIAL_USE_FGS_SUBTYPE
          is required whenever specialUse is declared.
        -->
        <service
            android:name=".ssh.SshKeepAliveService"
            android:foregroundServiceType="specialUse|dataSync"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent interactive SSH session keepalive" />
        </service>
    </application>
</manifest>
