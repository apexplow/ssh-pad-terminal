<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      INTERNET: required for SSHJ to open a TCP socket to the SSH server.
                Without this, the kernel rejects every socket() call with EPERM
                and connect() never reaches the wire.
      ACCESS_NETWORK_STATE: lets the SshClient probe WiFi/cell before opening
                a socket, so we can surface "no network" as a friendly error
                instead of a generic EPERM.
      These are normal-protection permissions; Android grants them at install
      time without prompting the user.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      FOREGROUND_SERVICE: required API 28+ for any process that calls
        Service.startForeground(). Promotes the app into the "perceptible"
        priority bucket so the OS does not kill us when the user backgrounds
        the app mid-session.
      FOREGROUND_SERVICE_DATA_SYNC: required API 34+ specifically for
        ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC. Mismatch between the
        manifest-declared type and the runtime-passed type crashes the
        process on API 34.
      POST_NOTIFICATIONS: required API 33+ for the system to actually show
        the foreground-service notification. Without it, startForeground
        still succeeds (the service runs), but the user sees nothing in the
        shade — defeating the purpose of the persistent notification.
        Requested at runtime on first connect (see SshTermApp.kt).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name=".SshTermApplication"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:label="SSH Term">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
          Started (not bound) foreground service. Started from SshClient on
          successful connect and stopped from SshClient.disconnect(). The
          service has no IPC surface — exported=false on API 31+ blocks
          external callers. foregroundServiceType="dataSync" must match the
          ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC constant passed to
          startForeground at runtime.
        -->
        <service
            android:name=".ssh.SshKeepAliveService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
    </application>
</manifest>
